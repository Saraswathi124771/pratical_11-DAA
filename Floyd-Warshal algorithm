# Floyd-Warshall Algorithm

INF = float('inf')

def floyd_warshall(graph, V):
    dist = [row[:] for row in graph]

    # Update shortest distances
    for k in range(V):
        for i in range(V):
            for j in range(V):
                dist[i][j] = min(dist[i][j],
                                 dist[i][k] + dist[k][j])

    return dist

# Number of vertices
V = 4

# Adjacency matrix
graph = [
    [0,   5,  INF, 10],
    [INF, 0,   3,  INF],
    [INF, INF, 0,   1],
    [INF, INF, INF, 0]
]

result = floyd_warshall(graph, V)

print("Shortest Distance Matrix:")
for row in result:
    print(row)
